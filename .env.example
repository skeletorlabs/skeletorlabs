# Optional. GitHub token used at build/revalidate time to read public repo
# metadata for the CV Projects section (raises the API rate limit from 60 to
# 5000 requests/hour). Server only: never prefix it with NEXT_PUBLIC_.
# A fine-grained token with no permissions (public repos, read-only) is enough.
GITHUB_TOKEN=

# Used by /labs
PINATA_API_KEY=
PINATA_API_SECRET=
PINATA_JWT=
PINATA_CLOUD=
BASE_RPC_HTTPS=
RESEND_API_KEY=
RESEND_EMAIL_TO=
CRYPTO_API_URL=
